# 复制成 .env 再填。.env 已被 gitignore,密钥只留在你机器上。
# 页面上也能配(首页「AI 模型」卡片),写的就是这个文件。

# 用哪家模型:qwen / minimax / deepseek / moonshot / zhipu / ollama
LLM_PROVIDER=qwen

# 各家自己的 key(填当前那家的就行)
DASHSCOPE_API_KEY=
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# 覆盖默认模型名(留空用默认。qwen 默认 qwen-plus)
LLM_MODEL=
# 快档模型:提取/匹配/抽简历用它。qwen 默认 qwen-flash(实测比 plus 快 2.6 倍)
LLM_MODEL_FAST=

# 向量模型(本地跑,默认 bge-m3,中英互通)
# EMBED_MODEL=BAAI/bge-m3

# 岗位库路径(默认 data/boss.db)
# BOSS_DB_PATH=data/boss.db
